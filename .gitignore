# ==========================================
# .gitignore - Standard Exclusions for Vibe Hub
# Prevents sensitive local configurations or bloated libraries from entering public Git
# ==========================================

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Dependency Folders ---
node_modules/
jspm_packages/
web_modules/
.npm/
.pnpm-store/
.yarn/
.bun/

# --- Build and Dist Outputs ---
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/

# --- Environment Variables & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert
*.pfx

# --- Logs and Diagnostics ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- IDE and Editor Configurations ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# --- System-level and Tool Cache Directories ---
.gemini/
.antigravity/
.cline/
.cursorrules_cache/
STATUS.md.bak
